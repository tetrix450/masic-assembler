;---------------------------------------------------
; RUTINA copy_buffer
; Copia size bytes de source a destination
; d13:       size                (16-bit)
; d14:       source pointer      (16-bit)
; d15:       destination pointer (16-bit)
;---------------------------------------------------
copy_buffer:

    load d13
    push
    load d13+1
    push

    load d14
    push
    load d14+1
    push

    load d15
    push
    load d15+1
    push

copy_buffer_loop:

    load d13
    or d13+1
    jz copy_buffer_end ; if size == 0 -> return

    load [d14]
    store [d15] ; *dst = *src

    INC16 d14 ; src++
    INC16 d15 ; dst++

    DEC16 d13 ; size--

    jmp copy_buffer_loop

copy_buffer_end:

    pop
    store d15+1
    pop
    store d15

    pop
    store d14+1
    pop
    store d14

    pop
    store d13+1
    pop
    store d13

ret

;---------------------------------------------------
; RUTINA mul16u
;
; PARÁMETROS
; d14       : operando A    (16 bits)
; d15       : operando B    (16 bits)
;
; TEMPORALES
; q0        : multiplicand  (32 bits)
; d13       : multiplier    (16 bits)
; r0        : contador      (8 bits)
;
; DEVUELVE
; q1        : resultado     (32 bits)
;
; CUIDADO: destruye q0, d13, r0
;---------------------------------------------------
mul16u:

    ;-------------------
    ; result = 0
    ;-------------------
    load #0
    store q1
    store q1+1
    store q1+2
    store q1+3

    ;-------------------
    ; multiplicand = a
    ;-------------------
    load d14
    store q0

    load d14+1
    store q0+1

    load #0
    store q0+2
    store q0+3

    ;-------------------
    ; multiplier = b
    ;-------------------
    load d15
    store d13

    load d15+1
    store d13+1

    ;-------------------
    ; contador = 16
    ;-------------------
    load #16
    store r0

mul16u_loop:

    ;-------------------
    ; if(multiplier & 1)
    ;-------------------
    load d13
    and #1
    jz mul16u_skip_add

    ADD32 q1, q0

mul16u_skip_add:

    ;-------------------
    ; multiplicand <<= 1
    ;-------------------
    SHL32 q0

    ;-------------------
    ; multiplier >>= 1
    ;-------------------
    SHR16 d13

    ;-------------------
    ; count--
    ;-------------------
    load r0
    sub #1
    store r0
    jnz mul16u_loop

ret

;---------------------------------------------------
; mul16s (SIGNED 16x16 -> 32 bits)
; PARÁMETROS
; d14        : operando A    (16 bits)
; d15        : operando B    (16 bits)
;
; TEMPORALES
; q0        : multiplicand  (32 bits)
; d13       : multiplier    (16 bits)
; r0        : contador      (8 bits)
; r1        : sign          (8 bits)
;
; DEVUELVE
; q1        : resultado     (32 bits)
;---------------------------------------------------
mul16s:

    load q0
    push
    load q0+1
    push
    load q0+2
    push
    load q0+3
    push

    load d13
    push
    load d13+1
    push

    load d15
    push
    load d15+1
    push

    load d14
    push
    load d14+1
    push

    load r0
    push

    load r1
    push

    ;---------------------------------------
    ; sign = 0
    ;---------------------------------------
    load #0
    store r1

    ;=================================================
    ; ABS(A) si negativo
    ;=================================================
    load d14+1
    and #0x80
    jz mul16s_a_ok

    ; marcar signo
    load #1
    store r1

    ; A = -A
    ABS16 d14

mul16s_a_ok:

    ;=================================================
    ; ABS(B) si negativo
    ;=================================================
    load d15+1
    and #0x80
    jz mul16s_b_ok

    ; flip signo
    load r1
    not
    and #1
    store r1

    ; B = -B
    ABS16 d15

mul16s_b_ok:

    ;=================================================
    ; unsigned multiply
    ;=================================================
    call mul16u

    ;=================================================
    ; aplicar signo
    ;=================================================
    load r1
    cmp #0
    jz mul16s_end

    ; negate 32-bit result
    load q1
    not
    add #1
    store q1

    load q1+1
    not
    adc #0
    store q1+1

    load q1+2
    not
    adc #0
    store q1+2

    load q1+3
    not
    adc #0
    store q1+3

mul16s_end:

    pop
    store r1

    pop
    store r0

    pop
    store d15+1
    pop
    store d15

    pop
    store d14+1
    pop
    store d14

    pop
    store d13+1
    pop
    store d13

    pop
    store q0+3
    pop
    store q0+2
    pop
    store q0+1
    pop
    store q0

ret

;---------------------------------------------------
; RUTINA plot
; Dibuja un carácter en pantalla en las coordenadas
; definidas por (r0, r1).
;
; PARÁMETROS:
; r0:       posición x
; r1:       posición y
; r2:      carácter que se va a dibujar
;
; TEMPORALES:
; d0:      puntero para dibujar
;---------------------------------------------------
plot:

    load d0
    push
    load d0+1
    push

    load r1
    store d0
    load #0
    store d0+1

    ; d0 << 7
    SHL16 d0
    SHL16 d0
    SHL16 d0
    SHL16 d0
    SHL16 d0
    SHL16 d0
    SHL16 d0

    ; d0 += r0
    load d0
    add r0
    store d0
    load d0+1
    adc #0
    store d0+1

    load r2
    out [d0]

    pop
    store d0+1
    pop
    store d0

ret

;---------------------------------------------------
; RUTINA clear_screen
; Limpia la pantalla.
;
;---------------------------------------------------
clear_screen:

    load d0
    push
    load d0+1
    push

    MOVI16 d0, 0

clear_screen_loop:
    
    load #' '
    out [d0]
    INC16 d0

    load d0+1
    cmp #0x20   ; limpiar hasta 8192 (0x2000)
    jnz clear_screen_loop

    pop
    store d0+1
    pop
    store d0

ret

;---------------------------------------------------
; RUTINA draw_line_h
; Dibuja una línea en octantes horizontales
;
; REGISTROS MODIFICADOS:
; r4:       ; abs(x)
; r5:       ; abs(y)
; r6:       ; x
; r7:       ; y
; r8:  dx   ; (x1 - x0)
; r9:  dy   ; (y1 - y0)
; r10:  D   ; factor de decisión
; r11:  dir ; dirección de crecimiento
;---------------------------------------------------
draw_line_h:
    ;-------------------
    ; if(x0 > x1)
    ;   swap(x0,x1)
    ;   swap(y0,y1)
    ;-------------------
    load r0
    cmp r2
    jnc draw_line_h_dxdy

    SWAP8 r0, r2
    SWAP8 r1, r3

draw_line_h_dxdy:

    ;-------------------
    ; dx = x1 - x0
    ;-------------------
    load r2
    sub r0
    store r8

    ;-------------------
    ; dy = y1 - y0
    ;-------------------
    load r3
    sub r1
    store r9

    ;-------------------
    ; if(dy < 0)
    ;   dir = -1
    ;   dir *= -1
    ; else
    ;   dir = 1
    ;-------------------
    cmp #0
    js draw_line_h_dir_neg

draw_line_h_dir_pos:

    load #1
    store r11
    jmp draw_line_h_dir_end
    
draw_line_h_dir_neg:

    load #-1
    store r11

    load r9
    not
    add #1
    store r9

draw_line_h_dir_end:

    ;-------------------
    ; D = 2*dy - dx
    ;-------------------
    load r9
    shl
    sub r8
    store r10

    ;-------------------
    ; y = y0
    ;-------------------
    load r1
    store r7

    ;-------------------
    ; x = x0
    ;-------------------
    load r0
    store r6

draw_line_h_loop:
    
    PLOT r6, r7

    ;-------------------
    ; if (D > 0)
    ;-------------------

    load r10
    cmp #0
    jns draw_line_h_D_pos

draw_line_h_D_neg:

    ;-------------------
    ; D = D + 2*dy
    ;-------------------
    load r9
    shl
    add r10
    store r10

    jmp draw_line_h_D_end

draw_line_h_D_pos:

    ;-------------------
    ; y = y + dir
    ;-------------------
    load r7
    add r11
    store r7

    ;-------------------
    ; D = D + (2*(dy - dx))
    ;-------------------
    load r9
    sub r8
    shl
    add r10
    store r10

draw_line_h_D_end:
                
    ;-------------------
    ; x++
    ;-------------------
    load r6
    add #1
    store r6

    ;-------------------
    ; if (x < x1) loop 
    ;------------------
    load r6
    cmp r2
    jnc draw_line_h_loop

ret

;---------------------------------------------------
; RUTINA draw_line_v
; Dibuja una línea en octantes verticales
;---------------------------------------------------
draw_line_v:
    ;-------------------
    ; if(y0 > y1)
    ;   swap(x0,x1)
    ;   swap(y0,y1)
    ;-------------------
    load r1
    cmp r3
    jnc draw_line_v_dxdy

    SWAP8 r0, r2
    SWAP8 r1, r3

draw_line_v_dxdy:

    ;-------------------
    ; dy = y1 - y0
    ;-------------------
    load r3
    sub r1
    store r9

    ;-------------------
    ; dx = x1 - x0
    ;-------------------
    load r2
    sub r0
    store r8

    ;-------------------
    ; if(dx < 0)
    ;   dir = -1
    ;   dir *= -1
    ; else
    ;   dir = 1
    ;-------------------
    cmp #0
    js draw_line_v_dir_neg

draw_line_v_dir_pos:

    load #1
    store r11
    jmp draw_line_v_dir_end
    
draw_line_v_dir_neg:

    load #-1
    store r11

    load r8
    not
    add #1
    store r8

draw_line_v_dir_end:

    ;-------------------
    ; D = 2*dx - dy
    ;-------------------
    load r8
    shl
    sub r9
    store r10

    ;-------------------
    ; y = y0
    ;-------------------
    load r1
    store r7

    ;-------------------
    ; x = x0
    ;-------------------
    load r0
    store r6

draw_line_v_loop:
    
    PLOT r6, r7

    ;-------------------
    ; if (D > 0)
    ;-------------------

    load r10
    cmp #0
    jns draw_line_v_D_pos

draw_line_v_D_neg:

    ;-------------------
    ; D = D + 2*dx
    ;-------------------
    load r8
    shl
    add r10
    store r10

    jmp draw_line_v_D_end

draw_line_v_D_pos:

    ;-------------------
    ; x = x + dir
    ;-------------------
    load r6
    add r11
    store r6

    ;-------------------
    ; D = D + (2*(dx - dy))
    ;-------------------
    load r8
    sub r9
    shl
    add r10
    store r10

draw_line_v_D_end:

    ;-------------------
    ; y++
    ;-------------------
    load r7
    add #1
    store r7

    ;-------------------
    ; if (y < y1) loop 
    ;-------------------
    load r7
    cmp r3
    jnc draw_line_v_loop

ret

;---------------------------------------------------
; RUTINA draw_line
; Dibujar una línea desde (x0, y0) hasta (x1, y1)
; r0:   x0
; r1:   y0
; r2:   x1
; r3:   y1
; 
;---------------------------------------------------
draw_line:

    load r4
    push
    load r5
    push
    load r6
    push
    load r7
    push
    load r8
    push
    load r9
    push
    load r10
    push
    load r11
    push

    ;-------------------
    ; ABSAC(x1 - x0)
    ;-------------------
    load r2
    sub r0
    ABSAC
    store r4

    ;-------------------
    ; ABSAC(y1 - y0)
    ;-------------------
    load r3
    sub r1
    ABSAC
    store r5

    ;-------------------
    ; if (abs_x > abs_y)
    ;   call draw_h
    ; else
    ;   call draw_v
    ;-------------------
    load r4
    cmp r5
    jnc draw_line_vertical

    call draw_line_h

    jmp draw_line_end

draw_line_vertical:

    call draw_line_v

draw_line_end:
    ; dibujar el último punto
    PLOT r2, r3

    pop
    store r11
    pop
    store r10
    pop
    store r9
    pop
    store r8
    pop
    store r7
    pop
    store r6
    pop
    store r5
    pop
    store r4

ret

;---------------------------------------------------
; RUTINA clear_registers
; Pone todos los registros a 0
;---------------------------------------------------
clear_registers:
    MOVI16 r0, register_bank + 79

clear_registers_loop:

    load #0
    store [r0]

DEC16 r0
load r0
or r0+1
jnz clear_registers_loop
ret