;---------------------------------------------------
;-------------- VECTORES INTERRUPCIÓN --------------
;---------------------------------------------------
.d16 start



;---------------------------------------------------
;-------------------- MACROS -----------------------
;---------------------------------------------------

;---------------------------------------------------
; SHIFTEAR UN DATO DE 16 BITS
; addr: dirección del dato en memoria.
;---------------------------------------------------
.macro SH16 addr
    load %addr
    shl
    store %addr
    load %addr+1
    rcl
    store %addr+1
.endm

;---------------------------------------------------
; INCREMENTAR UN DATO DE 16 BITS
; addr: dirección del dato en memoria.
;---------------------------------------------------
.macro INC16 addr
    load %addr
    inc
    store %addr
    load %addr+1
    adc #0
    store %addr+1
.endm



;---------------------------------------------------
;-------------------- RUTINAS ----------------------
;---------------------------------------------------
.org 0x0100

;---------------------------------------------------
; RUTINA plot
; Dibuja un carácter en pantalla en las coordenadas
; definidas por (plot_x, plot_y).
;
; PARÁMETROS:
; plot_x:       posición x
; plot_y:       posición y
; plot_char:    carácter que se va a dibujar
;---------------------------------------------------
plot:
    ;plot_temp = plot_y
    load plot_y
    store plot_temp
    load #0
    store plot_temp+1

    ; plot_temp << 7
    SH16 plot_temp
    SH16 plot_temp
    SH16 plot_temp
    SH16 plot_temp
    SH16 plot_temp
    SH16 plot_temp
    SH16 plot_temp

    ; plot_temp += plot_x
    load plot_temp
    add plot_x
    store plot_temp
    load plot_temp+1
    adc #0
    store plot_temp+1

    load plot_char
    out [plot_temp]
ret

;---------------------------------------------------
; RUTINA controller
; Contiene la lógica de ejecución del programa.
;---------------------------------------------------
controller:
    ;prev_x = x
    load x
    store prev_x

    ;prev_y = y
    load y
    store prev_y

    ;x += hspeed
    load x
    add hspeed
    store x

    ;y += vspeed
    load y
    add vspeed
    store y

    load x
    cmp #79
    jz invert_x

    load x
    cmp #0
    jz invert_x
    jmp check_y

invert_x:
    load hspeed
    not
    inc
    store hspeed
    
    check_y:
    load y
    cmp #59
    jz invert_y

    load y
    cmp #0
    jz invert_y
    jmp controller_end

invert_y:
    load vspeed
    not
    inc
    store vspeed
controller_end:
ret

;---------------------------------------------------
; RUTINA draw
; Dibujar en pantalla.
;---------------------------------------------------
draw:
    ;dibujar pelota en la siguiente posición
    load current_char
    inc
    store current_char
    store plot_char
    load x
    store plot_x
    load y
    store plot_y
    call plot

    ;borrar la pelota de la posición previa
    load #' '
    store plot_char
    load prev_x
    store plot_x
    load prev_y
    store plot_y
    call plot
ret

;---------------------------------------------------
; RUTINA delay
; Introduce un delay.
;
; PARÁMETROS
; delay_value: valor de escalado del delay. Un valor
; más grande introduce un retraso más largo.
;---------------------------------------------------
delay:
    load #0
    store delay_counter
    store delay_counter+1
delay_loop:

    INC16 delay_counter

    ; cmp16 delay_counter, delay_value
    load delay_counter
    cmp delay_value
    jnz delay_loop
    load delay_counter+1
    cmp delay_value+1
    jnz delay_loop
ret



;---------------------------------------------------
;--------------------- PROGRAMA --------------------
;---------------------------------------------------
start_counter: .d16 0
start:
    load #' '
    out [start_counter]

    INC16 start_counter

    load start_counter
    cmp #0x00
    jnz start
    load start_counter+1
    cmp #0x20
    jnz start
loop:
    call controller
    call draw
    call delay
jmp loop



;---------------------------------------------------
;--------------------- DATOS -----------------------
;---------------------------------------------------
.org 0x2000

;---------------------------------------------------
; VARIABLES PROGRAMA PRINCIPAL
;---------------------------------------------------

; Coordenadas de la pelota
x: .d8 3
y: .d8 13

; Coordenadas previas de la pelota
prev_x: .d8 0
prev_y: .d8 0

; Velocidad horizontal y vertical de la pelota
hspeed: .d8 1
vspeed: .d8 1

; Carácter que representa la pelota
current_char: .d8 '0'

;---------------------------------------------------
; VARIABLES RUTINA DELAY
;---------------------------------------------------
delay_counter: .d16 0
delay_value: .d16 500

;---------------------------------------------------
; VARIABLES RUTINA PLOT
;---------------------------------------------------
plot_x: .d8 0
plot_y: .d8 0
plot_char: .d8 0
plot_temp: .d16 0