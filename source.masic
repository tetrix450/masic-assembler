;---------------------------------------------------
;-------------- VECTORES INTERRUPCIÓN --------------
;---------------------------------------------------
.d16 start


;---------------------------------------------------
;------------------ CONSTANTES ---------------------
;---------------------------------------------------
.equ CENTER_X 40
.equ CENTER_Y 30


;---------------------------------------------------
;-------------------- MACROS -----------------------
;---------------------------------------------------

;---------------------------------------------------
; SHIFTEAR UN DATO DE 16 BITS
; addr: dirección del dato en memoria.
;---------------------------------------------------
.macro SH16 addr
    load %addr
    shl
    store %addr
    load %addr+1
    rcl
    store %addr+1
.endm

;---------------------------------------------------
; INCREMENTAR UN DATO DE 16 BITS
; addr: dirección del dato en memoria.
;---------------------------------------------------
.macro INC16 addr
    load %addr
    add #1
    store %addr
    load %addr+1
    adc #0
    store %addr+1
.endm

;---------------------------------------------------
; MOVER UN DATO DE 8 BITS DE UNA DIRECCIÓN A OTRA
;---------------------------------------------------
.macro MOV dest, source
    load %source
    store %dest
.endm

;---------------------------------------------------
; INTERCAMBIAR CONTENIDO ENTRE DOS POSICIONES DE MEMORIA
; addr1, addr2: direcciones de valores a intercambiar
;---------------------------------------------------
.macro SWAP addr1, addr2
    load %addr1
    store swap_temp

    load %addr2
    store %addr1

    load swap_temp
    store %addr2
.endm

;---------------------------------------------------
; DIBUJAR UN PUNTO EN (x, y)
; x, y: coordenadas del punto
;---------------------------------------------------
.macro PLOT x, y
    load %x
    store plot_x
    load %y
    store plot_y
    load #160
    store plot_char
    call plot
.endm

;---------------------------------------------------
; DIBUJAR LÍNEA
; x1, y1: punto inicial
; x2, y2: punto final
;---------------------------------------------------
.macro DRAW_LINE x1, y1, x2, y2
    load #%x1
    store draw_line_x1
    load #%y1
    store draw_line_y1
    load #%x2
    store draw_line_x2
    load #%y2
    store draw_line_y2
    call draw_line
.endm



;---------------------------------------------------
;-------------------- RUTINAS ----------------------
;---------------------------------------------------
.org 0x0100

;---------------------------------------------------
; RUTINA plot
; Dibuja un carácter en pantalla en las coordenadas
; definidas por (plot_x, plot_y).
;
; PARÁMETROS:
; plot_x:       posición x
; plot_y:       posición y
; plot_char:    carácter que se va a dibujar
;---------------------------------------------------
plot:
    ;plot_temp = plot_y
    load plot_y
    store plot_temp
    load #0
    store plot_temp+1

    ; plot_temp << 7
    SH16 plot_temp
    SH16 plot_temp
    SH16 plot_temp
    SH16 plot_temp
    SH16 plot_temp
    SH16 plot_temp
    SH16 plot_temp

    ; plot_temp += plot_x
    load plot_temp
    add plot_x
    store plot_temp
    load plot_temp+1
    adc #0
    store plot_temp+1

    load plot_char
    out [plot_temp]
ret

;---------------------------------------------------
; RUTINA controller
; Contiene la lógica de ejecución del programa.
;---------------------------------------------------
controller:
    
ret

;---------------------------------------------------
; RUTINA clear_screen
; Limpia la pantalla.
;---------------------------------------------------
clear_screen:
    load #0
    store clear_screen_counter
    store clear_screen_counter+1
clear_screen_loop:
    load #' '
    out [clear_screen_counter]
    INC16 clear_screen_counter
    load clear_screen_counter+1
    cmp #0x20
    jnz clear_screen_loop
ret

;---------------------------------------------------
; RUTINA init
; Inicializar las variables al comienzo del programa
;---------------------------------------------------
init:

ret

;---------------------------------------------------
; RUTINA draw_line_h
; Dibuja una línea en octantes horizontales
;---------------------------------------------------
draw_line_h:
    call draw_line
ret

draw_line:
    PLOT draw_line_x1, draw_line_y1
    PLOT draw_line_x2, draw_line_y2
ret

;---------------------------------------------------
; RUTINA draw
; Dibujar en pantalla.
;---------------------------------------------------
draw:
    DRAW_LINE CENTER_X, CENTER_Y, 60, 40
ret



;---------------------------------------------------
;--------------------- PROGRAMA --------------------
;---------------------------------------------------
start:
    call init
    call clear_screen
loop:
    call controller
    call draw
jmp loop



;---------------------------------------------------
;------------------- DATOS (RAM) -------------------
;---------------------------------------------------
.org 0x2000

;---------------------------------------------------
; VARIABLES PROGRAMA PRINCIPAL
;---------------------------------------------------


;---------------------------------------------------
; VARIABLES RUTINA plot
;---------------------------------------------------
plot_x:                 .r8 1
plot_y:                 .r8 1
plot_char:              .r8 1
plot_temp:              .r16 1

;---------------------------------------------------
; VARIABLES RUTINA clear_screen
;---------------------------------------------------
clear_screen_counter:   .r16 1

;---------------------------------------------------
; VARIABLES RUTINA draw_line
;---------------------------------------------------
; PARÁMETROS:
draw_line_x1:           .r8 1
draw_line_y1:           .r8 1
draw_line_x2:           .r8 1
draw_line_y2:           .r8 1

; TEMP:
draw_line_x:            .r8 1
draw_line_y:            .r8 1
draw_line_dx:           .r8 1
draw_line_dy:           .r8 1
draw_line_err:          .r8 1
draw_line_dir:          .r8 1
draw_line_abs_x:        .r8 1
draw_line_abs_y:        .r8 1

;---------------------------------------------------
; TEMPORALES MACRO SWAP
;---------------------------------------------------
swap_temp:              .r8 1