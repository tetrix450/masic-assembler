;---------------------------------------------------
;-------------- VECTORES INTERRUPCIÓN --------------
;---------------------------------------------------
.d16 start


;---------------------------------------------------
;------------------ CONSTANTES ---------------------
;---------------------------------------------------
.equ CENTER_X 40
.equ CENTER_Y 30


;---------------------------------------------------
;-------------------- MACROS -----------------------
;---------------------------------------------------

;---------------------------------------------------
; SHIFTEAR UN DATO DE 16 BITS
; addr: dirección del dato en memoria.
;---------------------------------------------------
.macro SH16 addr
    load %addr
    shl
    store %addr
    load %addr+1
    rcl
    store %addr+1
.endm

;---------------------------------------------------
; INCREMENTAR UN DATO DE 16 BITS
; addr: dirección del dato en memoria.
;---------------------------------------------------
.macro INC16 addr
    load %addr
    add #1
    store %addr
    load %addr+1
    adc #0
    store %addr+1
.endm

;---------------------------------------------------
; MOVER UN DATO DE 8 BITS DE UNA DIRECCIÓN A OTRA
;---------------------------------------------------
.macro MOV dest, source
    load %source
    store %dest
.endm

;---------------------------------------------------
; INTERCAMBIAR CONTENIDO ENTRE DOS POSICIONES DE MEMORIA
; addr1, addr2: direcciones de valores a intercambiar
;---------------------------------------------------
.macro SWAP addr1, addr2
    load %addr1
    push

    load %addr2
    store %addr1

    pop
    store %addr2
.endm

;---------------------------------------------------
; DIBUJAR UN PUNTO EN (x, y)
; x, y: coordenadas del punto
;---------------------------------------------------
.macro PLOT x, y
    load %x
    store plot_x
    load %y
    store plot_y
    load #160
    store plot_char
    call plot
.endm

;---------------------------------------------------
; CALCULAR VALOR ABSOLUTO DEL ACUMULADOR
;---------------------------------------------------
.macro ABS
    jns end
    not
    add #1
end:
.endm

;---------------------------------------------------
; DIBUJAR LÍNEA
; x0, y0: punto inicial
; x1, y1: punto final
;---------------------------------------------------
.macro DRAW_LINE x0, y0, x1, y1
    load #%x0
    store draw_line_x0
    load #%y0
    store draw_line_y0
    load #%x1
    store draw_line_x1
    load #%y1
    store draw_line_y1
    call draw_line
.endm



;---------------------------------------------------
;-------------------- RUTINAS ----------------------
;---------------------------------------------------
.org 0x0100

;---------------------------------------------------
; RUTINA plot
; Dibuja un carácter en pantalla en las coordenadas
; definidas por (plot_x, plot_y).
;
; PARÁMETROS:
; plot_x:       posición x
; plot_y:       posición y
; plot_char:    carácter que se va a dibujar
;---------------------------------------------------
plot:
    ;plot_temp = plot_y
    load plot_y
    store plot_temp
    load #0
    store plot_temp+1

    ; plot_temp << 7
    SH16 plot_temp
    SH16 plot_temp
    SH16 plot_temp
    SH16 plot_temp
    SH16 plot_temp
    SH16 plot_temp
    SH16 plot_temp

    ; plot_temp += plot_x
    load plot_temp
    add plot_x
    store plot_temp
    load plot_temp+1
    adc #0
    store plot_temp+1

    load plot_char
    out [plot_temp]
ret

;---------------------------------------------------
; RUTINA controller
; Contiene la lógica de ejecución del programa.
;---------------------------------------------------
controller:
    
ret

;---------------------------------------------------
; RUTINA clear_screen
; Limpia la pantalla.
;---------------------------------------------------
clear_screen:
    load #0
    store clear_screen_counter
    store clear_screen_counter+1
clear_screen_loop:
    load #' '
    out [clear_screen_counter]
    INC16 clear_screen_counter
    load clear_screen_counter+1
    cmp #0x20
    jnz clear_screen_loop
ret

;---------------------------------------------------
; RUTINA init
; Inicializar las variables al comienzo del programa
;---------------------------------------------------
init:

ret

;---------------------------------------------------
; RUTINA draw_line_h
; Dibuja una línea en octantes horizontales
;---------------------------------------------------
draw_line_h:
    ;-------------------
    ; if(x0 > x1)
    ;   swap(x0,x1)
    ;   swap(y0,y1)
    ;-------------------
    load draw_line_x0
    cmp draw_line_x1
    jnc draw_line_h_dxdy

    SWAP draw_line_x0, draw_line_x1
    SWAP draw_line_y0, draw_line_y1

draw_line_h_dxdy:

    ;-------------------
    ; dx = x1 - x0
    ;-------------------
    load draw_line_x1
    sub draw_line_x0
    store draw_line_dx

    ;-------------------
    ; dy = y1 - y0
    ;-------------------
    load draw_line_y1
    sub draw_line_y0
    store draw_line_dy

    ;-------------------
    ; if(dy < 0)
    ;   dir = -1
    ;   dir *= -1
    ; else
    ;   dir = 1
    ;-------------------
    cmp #0
    js draw_line_h_dir_neg

draw_line_h_dir_pos:

    load #1
    store draw_line_dir
    jmp draw_line_h_dir_end
    
draw_line_h_dir_neg:

    load #-1
    store draw_line_dir

    load draw_line_dy
    not
    add #1
    store draw_line_dy

draw_line_h_dir_end:

    ;-------------------
    ; D = 2*dy - dx
    ;-------------------
    load draw_line_dy
    shl
    sub draw_line_dx
    store draw_line_D

    ;-------------------
    ; y = y0
    ;-------------------
    load draw_line_y0
    store draw_line_y

    ;-------------------
    ; x = x0
    ;-------------------
    load draw_line_x0
    store draw_line_x

draw_line_h_loop:
    
    PLOT draw_line_x, draw_line_y

    ;-------------------
    ; if (D > 0)
    ;-------------------

    load draw_line_D
    cmp #0
    jns draw_line_h_D_pos

draw_line_h_D_neg:

    ;-------------------
    ; D = D + 2*dy
    ;-------------------
    load draw_line_dy
    shl
    add draw_line_D
    store draw_line_D

    jmp draw_line_h_D_end

draw_line_h_D_pos:

    ;-------------------
    ; y = y + dir
    ;-------------------
    load draw_line_y
    add draw_line_dir
    store draw_line_y

    ;-------------------
    ; D = D + (2*(dy - dx))
    ;-------------------
    load draw_line_dy
    sub draw_line_dx
    shl
    add draw_line_D
    store draw_line_D

draw_line_h_D_end:
                
    ;-------------------
    ; x++
    ;-------------------
    load draw_line_x
    add #1
    store draw_line_x

    ;-------------------
    ; if (x < x1) loop 
    ;------------------
    load draw_line_x
    cmp draw_line_x1
    jnc draw_line_h_loop

ret

;---------------------------------------------------
; RUTINA draw_line_v
; Dibuja una línea en octantes verticales
;---------------------------------------------------
draw_line_v:
    ;-------------------
    ; if(y0 > y1)
    ;   swap(x0,x1)
    ;   swap(y0,y1)
    ;-------------------
    load draw_line_y0
    cmp draw_line_y1
    jnc draw_line_v_dxdy

    SWAP draw_line_x0, draw_line_x1
    SWAP draw_line_y0, draw_line_y1

draw_line_v_dxdy:

    ;-------------------
    ; dy = y1 - y0
    ;-------------------
    load draw_line_y1
    sub draw_line_y0
    store draw_line_dy

    ;-------------------
    ; dx = x1 - x0
    ;-------------------
    load draw_line_x1
    sub draw_line_x0
    store draw_line_dx

    ;-------------------
    ; if(dx < 0)
    ;   dir = -1
    ;   dir *= -1
    ; else
    ;   dir = 1
    ;-------------------
    cmp #0
    js draw_line_v_dir_neg

draw_line_v_dir_pos:

    load #1
    store draw_line_dir
    jmp draw_line_v_dir_end
    
draw_line_v_dir_neg:

    load #-1
    store draw_line_dir

    load draw_line_dx
    not
    add #1
    store draw_line_dx

draw_line_v_dir_end:

    ;-------------------
    ; D = 2*dx - dy
    ;-------------------
    load draw_line_dx
    shl
    sub draw_line_dy
    store draw_line_D

    ;-------------------
    ; y = y0
    ;-------------------
    load draw_line_y0
    store draw_line_y

    ;-------------------
    ; x = x0
    ;-------------------
    load draw_line_x0
    store draw_line_x

draw_line_v_loop:
    
    PLOT draw_line_x, draw_line_y

    ;-------------------
    ; if (D > 0)
    ;-------------------

    load draw_line_D
    cmp #0
    jns draw_line_v_D_pos

draw_line_v_D_neg:

    ;-------------------
    ; D = D + 2*dx
    ;-------------------
    load draw_line_dx
    shl
    add draw_line_D
    store draw_line_D

    jmp draw_line_v_D_end

draw_line_v_D_pos:

    ;-------------------
    ; x = x + dir
    ;-------------------
    load draw_line_x
    add draw_line_dir
    store draw_line_x

    ;-------------------
    ; D = D + (2*(dx - dy))
    ;-------------------
    load draw_line_dx
    sub draw_line_dy
    shl
    add draw_line_D
    store draw_line_D

draw_line_v_D_end:
                
    ;-------------------
    ; y++
    ;-------------------
    load draw_line_y
    add #1
    store draw_line_y

    ;-------------------
    ; if (y < y1) loop 
    ;-------------------
    load draw_line_y
    cmp draw_line_y1
    jnc draw_line_v_loop

ret

draw_line:

    ;-------------------
    ; ABS(x1 - x0)
    ;-------------------
    load draw_line_x1
    sub draw_line_x0
    ABS
    store draw_line_abs_x

    ;-------------------
    ; ABS(y1 - y0)
    ;-------------------
    load draw_line_y1
    sub draw_line_y0
    ABS
    store draw_line_abs_y

    PLOT draw_line_x0, draw_line_y0
    PLOT draw_line_x1, draw_line_y1
ret

;---------------------------------------------------
; RUTINA draw
; Dibujar en pantalla.
;---------------------------------------------------
draw:
    DRAW_LINE CENTER_X, CENTER_Y, CENTER_X+10, CENTER_Y-10
ret



;---------------------------------------------------
;--------------------- PROGRAMA --------------------
;---------------------------------------------------
start:
    call init
    call clear_screen
loop:
    call controller
    call draw
jmp loop



;---------------------------------------------------
;------------------- DATOS (RAM) -------------------
;---------------------------------------------------
.org 0x2000

;---------------------------------------------------
; VARIABLES PROGRAMA PRINCIPAL
;---------------------------------------------------


;---------------------------------------------------
; VARIABLES RUTINA plot
;---------------------------------------------------
plot_x:                 .r8 1
plot_y:                 .r8 1
plot_char:              .r8 1
plot_temp:              .r16 1

;---------------------------------------------------
; VARIABLES RUTINA clear_screen
;---------------------------------------------------
clear_screen_counter:   .r16 1

;---------------------------------------------------
; VARIABLES RUTINA draw_line
;---------------------------------------------------
; PARÁMETROS:
draw_line_x0:           .r8 1
draw_line_y0:           .r8 1
draw_line_x1:           .r8 1
draw_line_y1:           .r8 1

; TEMP:
draw_line_x:            .r8 1
draw_line_y:            .r8 1
draw_line_dx:           .r8 1
draw_line_dy:           .r8 1
draw_line_D:          .r8 1
draw_line_dir:          .r8 1
draw_line_abs_x:        .r8 1
draw_line_abs_y:        .r8 1