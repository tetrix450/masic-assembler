.equ ejemplo +1000 -400*2 +(2*3 -5)
.org 0x0000; vectores de interrupción, comenzando por el vector de reset

reset:
.d16 inicio

puntero: .d16 0
datos: .d8 45, 50, 12, inicio + 0x9BC1*2(3-2), 10
buffer8: .r8 40
buffer16: .r16 10

cadena: .ascii "Hola EMASIC"
.equ doscientoscincuentaycinco 0xFF
.equ direccion1000 1000

.macro SUMAR op1 op2
    push

    load %op1
    add %op2
    store %op1

    pop
.endm

.macro PRINT_CHAR char_pointer index_pointer
    ;mover caracter a memoria de video
    load %char_pointer
    out [%index_pointer]

    ;incrementar puntero
    load %index_pointer
    inc
    load %index_pointer+1
    adc #0
.endm

.org 0x0100; código del programa (ROM)

inc_puntero:
    push

    load puntero
    inc
    store puntero

    load puntero+1
    inc
    store puntero+1

    pop
ret

inicio:
load #0
    bucle:
        store [puntero]
        call inc_puntero
        inc
    cmp #doscientoscincuentaycinco
    jnz bucle

store #-20 + 30 -4
load #-20
load puntero + (8 * 2 - 4) + 1

SUMAR direccion1 dato+2
SUMAR 0x0000 buffer8

PRINT_CHAR cadena 0
PRINT_CHAR cadena 1
PRINT_CHAR cadena 2

.org 0x2000; zona de variables (RAM)
puntero:
.d16 0x0000

ejemplo:
.d8 0x01 0x02 0x03 4 5 6 7 0b00001000
